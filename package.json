{
  "name": "@traceverse/genai-otel-instrument",
  "version": "0.1.0-dev.0",
  "description": "OpenTelemetry auto-instrumentation for GenAI applications on Node.js (port of genai_otel_instrument)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.19.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "sync": "node scripts/sync-from-python.mjs",
    "sync:check": "node scripts/sync-from-python.mjs --check",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": ">=0.200.0 <1",
    "@opentelemetry/exporter-metrics-otlp-proto": ">=0.200.0 <1",
    "@opentelemetry/exporter-trace-otlp-grpc": ">=0.200.0 <1",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.200.0 <1",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "openai": "^7.27.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
