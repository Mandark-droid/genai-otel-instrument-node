{
  "name": "@traceverse/genai-otel-instrument",
  "version": "0.1.0-dev.0",
  "description": "OpenTelemetry instrumentation for GenAI applications on Node.js, in browsers and in React Native (port of genai_otel_instrument)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.19.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.browser.mjs",
  "react-native": "./dist/index.react-native.js",
  "sideEffects": [
    "./src/**/*.ts",
    "./dist/index.js",
    "./dist/index.mjs",
    "./dist/register.js",
    "./dist/register.mjs"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.react-native.d.ts",
        "default": "./dist/index.react-native.js"
      },
      "browser": {
        "types": "./dist/index.browser.d.mts",
        "default": "./dist/index.browser.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/index.browser.d.mts",
      "default": "./dist/index.browser.mjs"
    },
    "./react-native": {
      "types": "./dist/index.react-native.d.ts",
      "default": "./dist/index.react-native.js"
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-contract-code.mjs",
    "sync": "node scripts/sync-from-python.mjs",
    "sync:check": "node scripts/sync-from-python.mjs --check",
    "prebuild": "npm run generate",
    "build": "tsup",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/tsconfig.json",
    "prelint": "npm run generate",
    "lint": "eslint .",
    "pretest": "npm run generate",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/dist-smoke.cjs",
    "compat": "node scripts/sdk-compat.cjs",
    "check:bundles": "node scripts/check-browser-bundle.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": ">=0.200.0 <1",
    "@opentelemetry/exporter-metrics-otlp-proto": ">=0.200.0 <1",
    "@opentelemetry/exporter-trace-otlp-grpc": ">=0.200.0 <1",
    "@opentelemetry/exporter-trace-otlp-proto": ">=0.200.0 <1",
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0",
    "@mistralai/mistralai": "*",
    "cohere-ai": "*",
    "groq-sdk": "*",
    "ollama": "*",
    "openai": ">=4.0.0",
    "together-ai": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "@mistralai/mistralai": {
      "optional": true
    },
    "cohere-ai": {
      "optional": true
    },
    "groq-sdk": {
      "optional": true
    },
    "ollama": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "together-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@eslint/js": "^9.39.5",
    "@mistralai/mistralai": "^2.7.0",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "cohere-ai": "^8.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "groq-sdk": "^1.6.0",
    "happy-dom": "^20.14.5",
    "ollama": "^0.6.4",
    "openai": "^7.27.0",
    "together-ai": "^0.57.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
