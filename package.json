{
  "name": "@traceverse/genai-otel-instrument-node",
  "version": "0.1.0-alpha.4",
  "description": "OpenTelemetry instrumentation for GenAI applications on Node.js, in browsers and in React Native (port of genai_otel_instrument)",
  "keywords": [
    "opentelemetry",
    "otel",
    "genai",
    "llm",
    "observability",
    "tracing",
    "instrumentation",
    "semantic-conventions",
    "gen_ai",
    "openai",
    "anthropic",
    "langchain",
    "mcp",
    "agents",
    "rag",
    "vector-database",
    "react-native",
    "cactus",
    "on-device",
    "browser",
    "cost-tracking",
    "token-usage",
    "otlp"
  ],
  "homepage": "https://mandark-droid.github.io/genai-otel-instrument-node-docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mandark-droid/genai-otel-instrument-node-docs.git"
  },
  "bugs": {
    "url": "https://github.com/Mandark-droid/genai-otel-instrument-node-docs/issues"
  },
  "author": "TraceVerse",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.19.0"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.browser.mjs",
  "react-native": "./dist/index.react-native.js",
  "sideEffects": [
    "./src/**/*.ts",
    "./dist/index.js",
    "./dist/index.mjs",
    "./dist/register.js",
    "./dist/register.mjs"
  ],
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.react-native.d.ts",
        "default": "./dist/index.react-native.js"
      },
      "browser": {
        "types": "./dist/index.browser.d.mts",
        "default": "./dist/index.browser.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/index.browser.d.mts",
      "default": "./dist/index.browser.mjs"
    },
    "./react-native": {
      "types": "./dist/index.react-native.d.ts",
      "default": "./dist/index.react-native.js"
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.mts",
        "default": "./dist/register.mjs"
      },
      "require": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "contract",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate-contract-code.mjs",
    "sync": "node scripts/sync-from-python.mjs",
    "sync:check": "node scripts/sync-from-python.mjs --check",
    "prebuild": "npm run generate",
    "build": "tsup",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p examples/tsconfig.json && node scripts/typecheck-onnx.mjs",
    "prelint": "npm run generate",
    "lint": "eslint .",
    "pretest": "npm run generate",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/dist-smoke.cjs",
    "compat": "node scripts/sdk-compat.cjs",
    "check:bundles": "node scripts/check-browser-bundle.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.0.0",
    "@opentelemetry/core": "^2.0.0",
