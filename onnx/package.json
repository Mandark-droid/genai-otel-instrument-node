{
  "name": "@traceverse/genai-otel-instrument-onnx",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Optional add-on to @traceverse/genai-otel-instrument: a Detoxify-style toxicity classifier run in-process with ONNX Runtime (GENAI_TOXICITY_ONNX_MODEL).",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run --config vitest.config.mts"
  },
  "dependencies": {
    "onnxruntime-node": "1.30.0"
  }
}
